---====== Debug entity ======---

entity:SetCallback("OnSpawned", function()
    print("Entity has spawned")

-- Âm thanh báo hiệu
local cue1 = Instance.new("Sound")
cue1.Parent = game.Workspace
cue1.Name = "Scream"
